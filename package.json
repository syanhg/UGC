{
  "name": "ugc",
  "version": "0.1.0",
  "description": "CLI for generating short, face-consistent UGC video clips with Google Veo",
  "type": "module",
  "bin": {
    "ugc": "dist/cli.js"
  },
  "scripts": {
    "ugc": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepack": "npm run build"
  },
  "keywords": [
    "veo",
    "video",
    "ugc",
    "gemini",
    "cli",
    "ai",
    "video-generation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syanhg/UGC.git"
  },
  "bugs": {
    "url": "https://github.com/syanhg/UGC/issues"
  },
  "homepage": "https://github.com/syanhg/UGC#readme",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist/",
    "src/",
    "ugc.config.example.json",
    "shots.example.txt",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "dependencies": {
    "@ai-sdk/google": "^4.0.25",
    "ai": "^7.0.37"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
