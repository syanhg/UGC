# Most people should just run `ugc setup`, which writes this file to ~/.ugc/.env
# with 0600 permissions. Copy this to .env only if you would rather manage it by
# hand, or want a per-project key that overrides the global one.
#
# A real environment variable always wins over both files.

# Gemini API key — Veo video generation runs on this.
# https://aistudio.google.com/apikey
# Note: Veo is not on the free tier; the key's project needs billing enabled.
GOOGLE_GENERATIVE_AI_API_KEY=
